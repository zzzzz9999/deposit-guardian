# DepositGuardian v3 — Environment Variables
# Copy this file to .env and fill in the values.

# === Project ===
ENVIRONMENT=local     # local | development | staging | production
DEBUG=true

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dg_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=deposit_guardian

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# === Auth (JWT) ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080     # 7 days

# === AI — Claude via Meituan MCLI ===
ANTHROPIC_AUTH_TOKEN=your-mcli-token-here
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_API_URL=https://mcli.sankuai.com/v1/messages

# === Frontend (Next.js public vars) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
